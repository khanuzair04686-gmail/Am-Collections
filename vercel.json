{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "index.html",
          "about.html",
          "admin.html",
          "404.html",
          "robots.txt",
          "sitemap.xml",
          "site.webmanifest",
          "icons/**",
          "css/**",
          "js/**",
          "uploads/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}